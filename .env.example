# ─────────────────────────────────────────────────────────────
#  Bölüm:    Faz 1 - Yapılandırma Şablonu
#  Dosya:    .env.example
#  Amaç:     VProvider'ın tüm ortam değişkenlerini gösteren şablon
#  Mekanik:  Bu dosya .env olarak kopyalanır; config.py buradan okur
# ─────────────────────────────────────────────────────────────

# Uygulama adı (site_info tamamlanana kadar kullanılır)
APP_NAME=VProvider

# Sunucu dinleme adresi (LAN için 0.0.0.0, sadece lokal için 127.0.0.1)
HOST=0.0.0.0
PORT=9055

# Bellek modu: keep (sürekli hazır) | dynamic (boşta boşalt)
MEMORY_MODE=dynamic

# Model kullanılırken sistem RAM'inin en fazla bu yüzdesi kullanılabilir.
# Boşta (model yüklü değilken) program hiçbir model belleği tutmaz; bu değer
# yalnızca model aktifken RAM'in tavanını belirler. 0 = sınırsız (eski davranış).
# Serbest bırakılacak RAM: total RAM - (total RAM x MEMORY_LIMIT_PCT / 100)
# Örn. 90 -> sistemin %90'ına kadar model kullanabilir, %10 sistem için kalır.
MEMORY_LIMIT_PCT=90

# dynamic modda boşta kalma süresi (dakika) -> süre dolunca model boşaltılır.
# 0 = kullanım biter bitmez GPU'dan anında boşaltılır (tek GPU'da birden
# çok model arasında geçiş yapmak için idealdir).
# CLI/opencode gibi istemciler arka arkaya istek atıyorsa 5-10 önerilir;
# aksi halde her yanıtta model yeniden yüklenir ve gecikme artar.
IDLE_TIMEOUT_MINUTES=5

# Model ve veri klasörleri
MODELS_DIR=models
DATA_DIR=data
DATABASE_PATH=data/vprovider.db

# LLM parametreleri
# CONTEXT_SIZE: bağlam (context) penceresi uzunluğu
CONTEXT_SIZE=4096
# GPU_MODE: auto (donanıma göre) | cuda | rocm | sycl | vulkan | metal | cpu
#   auto : NVIDIA/AMD/Intel/Apple Silicon algılanır; kurulu llama_cpp derlemesi
#          uyumluysa GPU, değilse otomatik CPU'ya döner (uyarı loglanır).
#   cuda/rocm/sycl/vulkan/metal : zorlamalı; backend derlenmemişse model
#          açılışında anlaşılır hata oluşur
#          (çözüm: Linux/macOS bash install.sh --rebuild, Windows install.ps1 -Rebuild).
#   cpu  : her zaman CPU.
GPU_MODE=auto
# GPU_LAYERS: -1 = otomatik (GPU_MODE'a göre VRAM'e güvenli hesap yapılır);
#             pozitif tam sayı = sabit katman sayısı; 0 = CPU.
GPU_LAYERS=-1
# THREADS: CPU iş parçacığı sayısı (0 = otomatik)
THREADS=0

# --- ComfyUI görsel üretim köprüsü (isteğe bağlı modül) ---
# true yaparsanız /v1/images/generations + panel "Görsel" sekmesi açılır.
# ComfyUI ayrı kurulur ve çalışır durumda olmalı (bkz. deploy/comfyui-rehber.md)
COMFYUI_ENABLED=false
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
# ComfyUI kurulum klasörü (scripts/comfyui.sh için; örn. /opt/ComfyUI)
COMFYUI_DIR=
# Varsayılan checkpoint (checkpoint yoksa 400 döner, panelden/API'den seçilebilir)
COMFYUI_DEFAULT_CHECKPOINT=
# Varsayılan negatif prompt
COMFYUI_DEFAULT_NEGATIVE=blur, ugly, low quality, watermark

# --- Yapay Zeka Hub'ı (görsel/video/ses/embedding — isteğe bağlı modül) ---
# true iken ağır paketler (torch/transformers/diffusers vb., bakınız
# requirements-hub.txt) kuruluysa ilgili yetenekler devreye girer.
# Kurulu değilse çekirdek aynen çalışır; bu anahtar "yoksa sessiz kapan" davranışını kontrol eder.
AI_HUB_ENABLED=true

# Embedding (metin gömme) modeli — /v1/embeddings
# Boş bırakılırsa yalnızca panelden kurulanlar (models/embeddings/) kullanılır.
# Bir model kimliği verirseniz (örn. sentence-transformers/all-MiniLM-L6-v2)
# o model varsayılan olur; ilk çağrıda HuggingFace'ten indirilir.
EMBEDDING_MODEL=

# --- Ses üretimi (TTS) köprüsü (isteğe bağlı modül, Faz 13) ---
# true yaparsanız /v1/audio/speech + panel "Ses Üretim" sekmesi açılır.
# Motor: edge-tts (Microsoft Edge çevrimiçi motoru) — internet gerektirir.
TTS_ENABLED=false
TTS_ENGINE=edge
# Varsayılan ses: tr-TR-EmelNeural (kadın) | tr-TR-AhmetNeural (erkek)
TTS_VOICE=tr-TR-EmelNeural
# Hız ayarı: +0% (normal), -10% (yavaş), +20% (hızlı)
TTS_VOICE_RATE=+0%

# --- Ses metne çevirme (STT) köprüsü (isteğe bağlı modül) ---
# true yaparsanız /v1/audio/transcriptions + panel "Ses Metne" sekmesi açılır.
# Motor: faster-whisper (ctranslate2). models/ct2/ klasöründe model bulunur.
STT_ENABLED=false
# Varsayılan model: base, small, medium, large-v2, large-v3...
STT_MODEL=base

# --- İnternet erişimi (yerleşik web araçları — VProvider2.1) ---
# Model, güncel bilgi için ücretsiz DuckDuckGo araması + sayfa okuma yapabilir.
# Arka planda hiçbir kaynak tüketilmez; yalnızca çağrı anında ağ kullanılır.
# Paneldeki "İnternet Erişimi" anahtarı DB'de kalıcıdır ve bu varsayılanı ezer:
WEB_TOOLS_ENABLED=true
# Metin arama sonucu sayısı (0-10)
WEB_SEARCH_MAX_RESULTS=5
# Görsel sonuç sayısı (0-8)
WEB_SEARCH_MAX_IMAGES=4
# DuckDuckGo bölgesi: tr-tr | us-en | en-us ...
WEB_SEARCH_REGION=tr-tr
# Sayfa okumada metinden alınacak karakter üst sınırı
WEB_FETCH_MAX_CHARS=8000
# Sayfa okumada indirilen bayt üst sınırı (2 MB varsayılan)
WEB_FETCH_MAX_BYTES=2097152
# Ağ çağrısı zaman aşımı (saniye)
WEB_TOOL_TIMEOUT=15
# Sunucu-tarafı araç döngüsünün üst sınırı (art arda arama turu)
WEB_TOOLS_MAX_ROUNDS=6

# HuggingFace erişim anahtarı (isteğe bağlı: gated/korumalı repolar için)
# Boş bırakılırsa halka açık repolar normal indirilir.
HF_TOKEN=